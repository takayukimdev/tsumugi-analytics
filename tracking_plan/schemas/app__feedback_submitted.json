{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tsumugi/app/feedback_submitted",
  "title": "feedback_submitted",
  "description": "User rates a model response (thumbs up/down).",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "UUIDv4; idempotency key",
      "x-pii": "none"
    },
    "event_name": {
      "type": "string",
      "description": "object_action, snake_case",
      "x-pii": "none",
      "const": "feedback_submitted"
    },
    "event_ts": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened (client clock)",
      "x-pii": "none"
    },
    "received_ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the collector received it",
      "x-pii": "none"
    },
    "org_id": {
      "type": "string",
      "description": "Customer organization",
      "x-pii": "identifier"
    },
    "user_id": {
      "type": "string",
      "description": "Acting user",
      "x-pii": "identifier"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Null for server-side events",
      "x-pii": "none"
    },
    "platform": {
      "type": "string",
      "enum": [
        "web",
        "ios",
        "android",
        "server"
      ],
      "x-pii": "none"
    },
    "app_version": {
      "type": "string",
      "x-pii": "none"
    },
    "schema_version": {
      "type": "integer",
      "x-pii": "none"
    },
    "properties": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "x-pii": "none"
        },
        "request_id": {
          "type": "string",
          "x-pii": "none"
        },
        "rating": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ],
          "x-pii": "none"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "inaccurate",
            "unhelpful",
            "too_slow",
            "unsafe",
            "other",
            null
          ],
          "x-pii": "none"
        }
      },
      "required": [
        "message_id",
        "request_id",
        "rating",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_name",
    "event_ts",
    "received_ts",
    "org_id",
    "user_id",
    "session_id",
    "platform",
    "app_version",
    "schema_version",
    "properties"
  ],
  "additionalProperties": false
}
