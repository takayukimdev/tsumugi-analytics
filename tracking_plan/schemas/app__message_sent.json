{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tsumugi/app/message_sent",
  "title": "message_sent",
  "description": "User submits a prompt. The prompt text itself is only in the inference log.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "UUIDv4; idempotency key",
      "x-pii": "none"
    },
    "event_name": {
      "type": "string",
      "description": "object_action, snake_case",
      "x-pii": "none",
      "const": "message_sent"
    },
    "event_ts": {
      "type": "string",
      "format": "date-time",
      "description": "When it happened (client clock)",
      "x-pii": "none"
    },
    "received_ts": {
      "type": "string",
      "format": "date-time",
      "description": "When the collector received it",
      "x-pii": "none"
    },
    "org_id": {
      "type": "string",
      "description": "Customer organization",
      "x-pii": "identifier"
    },
    "user_id": {
      "type": "string",
      "description": "Acting user",
      "x-pii": "identifier"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Null for server-side events",
      "x-pii": "none"
    },
    "platform": {
      "type": "string",
      "enum": [
        "web",
        "ios",
        "android",
        "server"
      ],
      "x-pii": "none"
    },
    "app_version": {
      "type": "string",
      "x-pii": "none"
    },
    "schema_version": {
      "type": "integer",
      "x-pii": "none"
    },
    "properties": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string",
          "x-pii": "none"
        },
        "message_id": {
          "type": "string",
          "x-pii": "none"
        },
        "request_id": {
          "type": "string",
          "description": "Inference request triggered",
          "x-pii": "none"
        },
        "prompt_chars": {
          "type": "integer",
          "x-pii": "none"
        },
        "has_attachment": {
          "type": "boolean",
          "x-pii": "none"
        }
      },
      "required": [
        "conversation_id",
        "message_id",
        "request_id",
        "prompt_chars",
        "has_attachment"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_name",
    "event_ts",
    "received_ts",
    "org_id",
    "user_id",
    "session_id",
    "platform",
    "app_version",
    "schema_version",
    "properties"
  ],
  "additionalProperties": false
}
