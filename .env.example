# Copy to .env and fill in. .env is gitignored.

# Google Cloud
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1

# Pseudonymization key for offline runs (on GCP it comes from Secret Manager).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_KEY=

# Optional: Slack incoming webhook for pipeline failure alerts (stubbed if empty)
SLACK_WEBHOOK_URL=
