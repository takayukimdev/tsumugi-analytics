[sqlfluff]
dialect = bigquery
# jinja templater: lints without a warehouse connection. It mocks dbt builtins:
# is_incremental() -> True, var() -> "item" (never use var() where SQL needs a number).
templater = jinja
max_line_length = 100
# ST06: column order in SELECT is chosen for readability, not wildcards-last.
exclude_rules = ST06

[sqlfluff:templater:jinja]
apply_dbt_builtins = True
load_macros_from_path = dbt/macros

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = lower
